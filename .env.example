# Copy to .env.local (never commit .env.local)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional server-only (API routes / scripts — never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# DB schema used by the JS client (see src/supabase.js)
# Default is public (deployment). Only set this for a non-public staging schema.
# VITE_SUPABASE_SCHEMA=public
